# Salin file ini jadi .env. PORT saja sudah cukup untuk menjalankan aplikasi —
# dua fitur AI (pengamatan mingguan di Dashboard, rangkuman kegiatan di Riwayat)
# butuh salah satu provider di bawah diisi. Tanpa itu, semuanya tetap jalan,
# dua kotak itu saja yang bilang belum dikonfigurasi.

PORT=3000

# Siapa pun yang bisa membuka alamat server ini bisa membuat akun. Setelah semua orang
# yang kamu ajak sudah mendaftar, ubah ke false supaya pendaftaran ditutup.
# (Akun pertama selalu bisa dibuat, apa pun nilainya.)
ALLOW_SIGNUP=true

# --- Lupa kata sandi lewat email ---
# Pilih salah satu pengirim: Brevo (HTTPS), SMTP, atau Resend. EMAIL_FROM wajib diisi.
# Urutan yang dipakai: SMTP (kalau ada SMTP_HOST/SMTP_USER/SMTP_PASS), lalu Brevo,
# lalu Resend.
#
# Brevo, paling mudah di Railway karena Railway memblokir port SMTP 25/465/587:
# - daftar gratis di https://www.brevo.com
# - verifikasi alamat pengirim di Senders, Domains & IPs -> Senders
# - buat API key di SMTP & API -> API keys (bukan SMTP key)
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=Djournl <alamat@gmail.com>
#
# SMTP, contoh Gmail. Gmail butuh 2-Step Verification dan App Password (bukan kata sandi
# biasa). Pakai ini hanya di hosting yang mengizinkan SMTP keluar (Fly.io, VPS, lokal);
# di Railway akan timeout.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=alamat@gmail.com
# SMTP_PASS=app-password-16-karakter
# EMAIL_FROM=Djournl <alamat@gmail.com>
#
# Resend, butuh domain yang sudah diverifikasi di https://resend.com:
# RESEND_API_KEY=
# EMAIL_FROM=Djournl <no-reply@domainmu.com>
#
# Tanpa pengirim yang lengkap, tombol "Lupa kata sandi?" akan menjelaskan bahwa fitur
# ini belum diaktifkan, dan pemilik server masih bisa memakai npm run reset-password.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=
# Alamat publik aplikasi, dipakai untuk menyusun tautan di email. Kalau dikosongkan,
# alamatnya diambil dari permintaan yang sedang berjalan (cukup untuk sebagian besar
# hosting di balik TRUST_PROXY).
# APP_URL=https://jurnal.contoh.com

# Semua akun memakai kunci AI yang sama (milikmu), jadi tiap akun dibatasi sekian
# permintaan AI per hari supaya biayanya tidak mengejutkan.
AI_DAILY_LIMIT=30

# --- Kalau dipasang di internet ---
# Jumlah proxy di depan aplikasi (platform hosting atau Caddy/Nginx biasanya 1).
# Kosongkan kalau aplikasi diakses langsung tanpa proxy, misalnya saat dijalankan lokal.
TRUST_PROXY=

# Hanya untuk docker-compose.prod.yml: domain yang mengarah ke servermu.
# DOMAIN=jurnal.contoh.com

# Opsional: folder tempat database disimpan. Default-nya ./data.
# DATA_DIR=/var/lib/djournl

# Pilih salah satu: anthropic (default) | openai | openai_compatible
#
# Contoh penyedia gratis: Groq (https://console.groq.com), lewat openai_compatible:
#   AI_PROVIDER=openai_compatible
#   AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
#   AI_MODEL=openai/gpt-oss-120b
#   AI_API_KEY=gsk_...
# Model yang tersedia berbeda tiap akun; lihat daftar Models di konsol penyedianya.
AI_PROVIDER=anthropic

# --- anthropic ---
# Dari https://console.anthropic.com — pemakaian dikenai biaya sesuai akunmu.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- openai ---
# Dari https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- openai_compatible ---
# Untuk provider lain yang meniru endpoint chat/completions OpenAI
# (Groq, Together AI, Mistral, atau model lokal lewat proxy semacam Ollama).
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
